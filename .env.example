# Copy to .env.local and fill in. Never commit .env.local.

# Convex (written by `npx convex dev`; keep as the CLI writes it)
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=

# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/onboarding

# Set on the Convex deployment with `npx convex env set NAME value`, NOT here:
#   CLERK_JWT_ISSUER_DOMAIN   (Phase 1)
#   CLERK_WEBHOOK_SECRET      (Phase 2)
