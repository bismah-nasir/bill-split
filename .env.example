# Copy to .env.local and fill in. Never commit .env.local.

# Convex (written by `npx convex dev`; keep as the CLI writes it)
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=

# There are no auth variables here. Convex Auth's settings live on the Convex
# deployment, set by `npx @convex-dev/auth` (or `npx convex env set NAME value`), NOT here:
#   SITE_URL          (Phase 1; http://localhost:3000 in dev)
#   JWT_PRIVATE_KEY   (Phase 1; generated)
#   JWKS              (Phase 1; generated)
